PORT=8084
NODE_ENV=development
LOG_LEVEL=INFO

# langextract → Gemini (Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash
LANGEXTRACT_TEMPERATURE=0.1

# GCP
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET_DOCUMENTOS=hipotecai-documentos

# OAuth
GOOGLE_CLIENT_ID=

# CORS
ALLOWED_ORIGINS=http://localhost:3030,http://localhost:3000

# Postgres
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hipotecai
DB_PORT=5432
INSTANCE_CONNECTION_NAME=

SKIP_AUTH=false
